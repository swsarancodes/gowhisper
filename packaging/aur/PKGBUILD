# Maintainer: dax
#
# Not a prebuilt of extra/hex (the hex dump tool, which installs /usr/bin/hx):
# this is the GoSpell voice dictation app, so it neither provides nor conflicts
# with it.
#
# Generated from goml/gospell packaging/aur by scripts/release-aur.sh, which
# sets pkgver, the release service's linux-x64 and linux-arm64 file URLs, and
# the checksums for each release.
pkgname=gospell-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='GoSpell voice dictation app by GoML: hold a key, speak, and it types (Linux beta; not the hex dump tool)'
arch=('x86_64' 'aarch64')
url='https://github.com/goml/gospell'
license=('MIT')
# Linked: alsa-lib, gcc-libs, glibc, vulkan-icd-loader. Loaded at
# runtime: the X11/Wayland/xkbcommon client libraries and OpenBLAS.
depends=(
  'alsa-lib' 'curl' 'gcc-libs' 'glibc' 'libx11' 'libxcb' 'libxcursor'
  'libxi' 'libxkbcommon' 'libxkbcommon-x11' 'openblas' 'vulkan-icd-loader'
  'wayland'
)
optdepends=(
  'wl-clipboard: paste on Wayland'
  'wtype: paste on Wayland'
  'vulkan-driver: GPU transcription'
  'wireplumber: mute output while dictating (or libpulse for pactl)'
  'xdg-utils: open links from voice commands'
)
options=('!strip' '!debug')
install=gospell-bin.install
source=(
  'com.goml.gospell.desktop'
  'gospell.service'
  'LICENSE'
  'com.goml.gospell-16.png' 'com.goml.gospell-24.png' 'com.goml.gospell-32.png' 'com.goml.gospell-48.png'
  'com.goml.gospell-64.png' 'com.goml.gospell-128.png' 'com.goml.gospell-256.png' 'com.goml.gospell-512.png'
)
source_x86_64=("gospell-${pkgver}-linux-x64::@URL_X64@")
source_aarch64=("gospell-${pkgver}-linux-arm64::@URL_ARM64@")
sha256sums=('@DESKTOP_SHA256@'
            '@SERVICE_SHA256@'
            '@LICENSE_SHA256@'
            @ICON_SHA256S@)
sha256sums_x86_64=('@SHA256_X64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  local target=x64
  [ "$CARCH" = aarch64 ] && target=arm64
  install -Dm755 "gospell-${pkgver}-linux-${target}" "$pkgdir/usr/bin/gospell"
  install -Dm644 com.goml.gospell.desktop "$pkgdir/usr/share/applications/com.goml.gospell.desktop"
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "com.goml.gospell-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/com.goml.gospell.png"
  done
  install -Dm644 gospell.service "$pkgdir/usr/lib/systemd/user/gospell.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
