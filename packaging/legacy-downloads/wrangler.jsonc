// Kit's personal Cloudflare account, where both zones, the gospell-releases bucket
// and the old gospell-voice-site Worker live. Deploying this attaches all four
// hosts to this Worker (see README.md); `wrangler delete` with this config
// removes it again.
{
  "name": "gospell-legacy-downloads",
  "account_id": "19d80aa432b86d110c8e1480cf895f5c",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // Routes run in front of the gospell-releases bucket's custom domains.
    { "pattern": "downloads.gospell.goml.io/*", "zone_name": "kitlangton.dev" },
    { "pattern": "downloads.gospell.goml.io/*", "zone_name": "kitlangton.com" },
    // The website hosts move from gospell-voice-site to this Worker.
    { "pattern": "gospell.kitlangton.dev", "custom_domain": true },
    { "pattern": "gospell.goml.io", "custom_domain": true },
  ],
}
