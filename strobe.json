{
  "$schema": "https://raw.githubusercontent.com/anomalyco/strobe/main/schema/strobe.v1.json",
  "build": {
    "command": "cargo build --locked --release --bin gospell",
    "output": {
      "windows": "{cache}/cargo-target/release/gospell.exe",
      "macos": "{cache}/cargo-target/release/gospell",
      "linux": "{cache}/cargo-target/release/gospell"
    },
    "env": {
      "CARGO_TARGET_DIR": "{cache}/cargo-target",
      "CARGO_PROFILE_RELEASE_DEBUG": "line-tables-only",
      "CARGO_PROFILE_RELEASE_STRIP": "false",
      "CARGO_PROFILE_RELEASE_INCREMENTAL": "false",
      "TRANSCRIBE_CMAKE_ARGS": "-DGGML_NATIVE=OFF"
    },
    "windows": {
      "env": { "RUSTUP_TOOLCHAIN": "stable-x86_64-pc-windows-msvc" }
    }
  },
  "apps": {
    "gospell": {
      "kind": "native",
      "exe": {
        "windows": "target/release/gospell.exe",
        "macos": "/Applications/GoSpell.app/Contents/MacOS/gospell",
        "linux": "~/.local/share/gospell/current/gospell"
      },
      "args": ["app"],
      "env": {
        "GOSPELL_APPLICATION_SUPPORT_DIR": "{home}/gospell-data",
        "GOSPELL_DISABLE_UPDATES": "1",
        "HF_HUB_CACHE": "{home}/.cache/huggingface/hub"
      },
      "unset": ["GOSPELL_*", "WGPU_*", "RUNE_*", "HF_HOME", "RUST_LOG"],
      "moved": ["~/Library/Application Support/gospell"],
      "files": {
        "gospell-data/onboarding-complete": "",
        "gospell-data/settings.json": {
          "enable_on_launch": false,
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "goml-gospell-identity"]
        }
      },
      "guard": [
        { "os": "windows", "file": "%APPDATA%/gospell/local-api.json", "pid": "pid" },
        { "os": "windows", "file": "%APPDATA%/gospell/settings.json" },
        { "os": "macos", "file": "~/Library/Application Support/gospell/local-api.json", "pid": "pid" },
        { "os": "macos", "file": "~/Library/Application Support/gospell/settings.json" },
        { "os": "linux", "file": "~/.local/share/gospell/local-api.json", "pid": "pid" },
        { "os": "linux", "file": "~/.local/share/gospell/settings.json" }
      ]
    },
    "gospell-listening": {
      "extends": "gospell",
      "files": {
        "gospell-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": true,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "goml-gospell-identity"]
        }
      }
    },
    "gospell-listening-warm": {
      "extends": "gospell",
      "files": {
        "gospell-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "goml-gospell-identity"]
        }
      }
    },
    "gospell-dictation": {
      "extends": "gospell",
      "env": { "GOSPELL_AUDIO_FIXTURE": "{home}/speech.wav" },
      "files": {
        "gospell-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": false,
          "sound_effects": false,
          "show_dock_icon": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "goml-gospell-identity"]
        }
      }
    },
    "gospell-dictation-released": {
      "extends": "gospell-dictation",
      "files": {
        "gospell-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": true,
          "sound_effects": false,
          "show_dock_icon": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "goml-gospell-identity"]
        }
      }
    }
  },
  "benches": ["perf/**/*.bench.ts"],
  "metrics": { "equivalence": "2%" }
}
